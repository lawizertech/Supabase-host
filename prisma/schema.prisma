generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model services {
  id                  String    @id
  service_id          String    @unique
  title               String
  subtitle            String?
  badge_text          String?
  icon                String?
  content_title       String?
  content_description String?
  section1_title      String?
  price               Float?
  original_price      Float?
  theme               Json?
  primary_color       String?
  primary_bg          String?
  primary_hover_bg    String?
  benefits            Json?
  faqs                Json?
  sections            Json?
  addons              Json?
  category            String?
  is_active           Boolean   @default(true)
  created_at          DateTime? @default(now())
  updated_at          DateTime?

  @@schema("public")
}

model profiles {
  id                  String    @id @db.Uuid
  role                String    @default("client")
  name                String?
  email               String?
  phone               String?
  professional_status String?
  city                String?
  state               String?
  photo_url           String?
  has_password        Boolean   @default(false)
  created_at          DateTime? @default(now())
  updated_at          DateTime? @default(now())

  cases_as_client       cases[]                @relation("cases_client_idToprofiles")
  cases_as_professional cases[]                @relation("cases_professional_idToprofiles")
  case_documents        case_documents[]
  chat_messages         chat_messages[]
  notifications         notifications[]

  @@schema("public")
}

model cases {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id       String    @db.Uuid
  professional_id String?   @db.Uuid
  case_type       String
  status          String    @default("created")
  stages          Json?     @default("[]")
  created_at      DateTime? @default(now())
  updated_at      DateTime? @default(now())

  client       profiles  @relation("cases_client_idToprofiles", fields: [client_id], references: [id], onDelete: Cascade)
  professional profiles? @relation("cases_professional_idToprofiles", fields: [professional_id], references: [id])

  case_documents case_documents[]
  chat_messages  chat_messages[]
  meetings       meetings[]
  payments       payments[]

  @@index([client_id])
  @@index([professional_id])
  @@index([status])
  @@schema("public")
}



model case_documents {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id      String    @db.Uuid
  uploaded_by  String?   @db.Uuid
  storage_path String
  filename     String?
  file_type    String?
  size_bytes   BigInt?
  created_at   DateTime? @default(now())

  case          cases           @relation(fields: [case_id], references: [id], onDelete: Cascade)
  profile       profiles?       @relation(fields: [uploaded_by], references: [id])
  chat_messages chat_messages[]

  @@index([case_id])
  @@schema("public")
}



model chat_messages {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id        String    @db.Uuid
  sender_id      String?   @db.Uuid
  text           String?
  attachment_ref String?   @db.Uuid
  created_at     DateTime? @default(now())
  read_at        DateTime?
  flagged_by     String[]  @default([]) @db.Uuid
  sender_role    String?
  message_type   String?   @default("text")
  deleted_at     DateTime?

  case       cases           @relation(fields: [case_id], references: [id], onDelete: Cascade)
  sender     profiles?       @relation(fields: [sender_id], references: [id])
  attachment case_documents? @relation(fields: [attachment_ref], references: [id])

  @@index([case_id])
  @@schema("public")
}

model meetings {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id       String    @db.Uuid
  title         String    @default("Consultation")
  scheduled_for DateTime?
  start_time    DateTime?
  end_time      DateTime?
  status        String?   @default("proposed")
  meeting_link  String?
  created_at    DateTime? @default(now())

  case                 cases                  @relation(fields: [case_id], references: [id], onDelete: Cascade)


  @@index([case_id])
  @@schema("public")
}



model payments {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id             String    @db.Uuid
  razorpay_order_id   String?
  razorpay_payment_id String?   @unique
  status              String?
  amount              Decimal?  @db.Decimal(12, 2)
  verified_at         DateTime?
  raw_webhook_payload Json?
  refund_status       String?
  refund_id           String?
  created_at          DateTime? @default(now())

  case cases @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id])
  @@schema("public")
}

model notifications {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient_id String    @db.Uuid
  type         String
  payload      Json      @default("{}")
  read_at      DateTime?
  created_at   DateTime? @default(now())

  recipient profiles @relation(fields: [recipient_id], references: [id], onDelete: Cascade)

  @@schema("public")
}


